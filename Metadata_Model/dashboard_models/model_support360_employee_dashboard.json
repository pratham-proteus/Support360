{
  "DASHBOARD": {
    "DASHBOARD_ID": "SUPPORT360_EMPLOYEE_DASHBOARD",
    "DASHBOARD_TYPE": "S",
    "DASHBOARD_NAME": "Employee Dashboard",
    "DASHBOARD_DESCR": "Personal ticket analytics for the current Employee: their own tickets by priority and by status.",
    "CREATED_BY": "kandarp.baghar@proteustech.co",
    "CREATED_DATE": "2026-09-24",
    "REFRESH_INTERVAL_SECONDS": 0,
    "GLOBAL_CRITERIA": [
      {
        "PARAM_NAME": "CREATED_FROM",
        "PROMPT_LABEL": "Created From",
        "DEFAULT_VALUE": ":calendar_month_start",
        "DATA_TYPE": "date",
        "OPERATOR": ">=",
        "BROADCAST_TO": [
          "VIS_STATUS"
        ]
      },
      {
        "PARAM_NAME": "CREATED_TO",
        "PROMPT_LABEL": "Created To",
        "DEFAULT_VALUE": ":calendar_today",
        "DATA_TYPE": "date",
        "OPERATOR": "<=",
        "BROADCAST_TO": [
          "VIS_STATUS"
        ]
      }
    ],
    "VISUALS": [
      {
        "VISUAL_ID": "VIS_KPI_TOTAL",
        "VISUAL_NAME": "Total",
        "POSITION": {
          "X": 0,
          "Y": 0,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_total_tickets_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_KPI_OPEN",
        "VISUAL_NAME": "Open",
        "POSITION": {
          "X": 3,
          "Y": 0,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_open_tickets_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_KPI_ASSIGNED",
        "VISUAL_NAME": "Assigned",
        "POSITION": {
          "X": 6,
          "Y": 0,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_assigned_tickets_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_KPI_IN_PROGRESS",
        "VISUAL_NAME": "In Progress",
        "POSITION": {
          "X": 9,
          "Y": 0,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_in_progress_tickets_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_KPI_RESOLVED",
        "VISUAL_NAME": "Resolved",
        "POSITION": {
          "X": 0,
          "Y": 2,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_awaiting_confirmation_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_KPI_CLOSED",
        "VISUAL_NAME": "Closed",
        "POSITION": {
          "X": 3,
          "Y": 2,
          "WIDTH": 3,
          "HEIGHT": 2
        },
        "VISUAL_CONFIG_REF": "model_support360_my_closed_tickets_count.json",
        "CRITERIA_BINDINGS": []
      },
      {
        "VISUAL_ID": "VIS_STATUS",
        "VISUAL_NAME": "My Tickets by Status",
        "POSITION": {
          "X": 0,
          "Y": 4,
          "WIDTH": 12,
          "HEIGHT": 4
        },
        "VISUAL_CONFIG_REF": "model_support360_my_tickets_by_status.json",
        "CRITERIA_BINDINGS": [
          {
            "VISUAL_PARAM": "created_from",
            "BIND_TYPE": "global",
            "GLOBAL_PARAM": "CREATED_FROM"
          },
          {
            "VISUAL_PARAM": "created_to",
            "BIND_TYPE": "global",
            "GLOBAL_PARAM": "CREATED_TO"
          }
        ]
      },
      {
        "VISUAL_ID": "VIS_ACTIVE_GRID",
        "VISUAL_NAME": "My Active Tickets",
        "POSITION": {
          "X": 0,
          "Y": 8,
          "WIDTH": 12,
          "HEIGHT": 6
        },
        "VISUAL_CONFIG_REF": "model_support360_my_active_tickets_grid.json",
        "CRITERIA_BINDINGS": [
          {
            "VISUAL_PARAM": "created_from",
            "BIND_TYPE": "global",
            "GLOBAL_PARAM": "CREATED_FROM"
          },
          {
            "VISUAL_PARAM": "created_to",
            "BIND_TYPE": "global",
            "GLOBAL_PARAM": "CREATED_TO"
          }
        ]
      }
    ],
    "DRILL_THROUGH": [
      {
        "SOURCE_VISUAL_ID": "VIS_ACTIVE_GRID",
        "TARGET_TYPE": "visual",
        "TARGET_VISUAL_ID": "support360_ticket_detail_log_grid",
        "PARAM_MAPPING": {
          "SUPPORT360_TICKET_TICKET_NO": "ticket_no"
        }
      }
    ]
  }
}