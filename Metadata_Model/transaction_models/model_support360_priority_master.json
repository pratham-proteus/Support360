          "actions": [
            {
              "name": "Activate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "activate_priority",
                "description": "Reactivate a priority level",
                "spec": "Set IS_ACTIVE to 'Y' for the current priority record and return the updated form values so the grid reflects the change immediately."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be inactive",
                  "message": "Priority {form.priority_code} is already active.",
                  "expression": "{form.is_active} == \"N\""
                }
              ]
            },
            {
              "name": "Deactivate",
              "handler": "item_change",
              "scope": "row",
              "business_logic": {
                "method": "deactivate_priority",
                "description": "Deactivate a priority level",
                "spec": "Set IS_ACTIVE to 'N' for the current priority record and return the updated form values so the grid reflects the change immediately. Used both as a direct action and as the forced outcome when a delete is attempted on a priority that is referenced by existing tickets."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be active",
                  "message": "Priority {form.priority_code} is already inactive.",
                  "expression": "{form.is_active} == \"Y\""
                }
              ]
            }
          ],
          "validations": [
            {
              "type": "business_logic",
              "name": "Block delete when referenced by tickets",
              "message": "This priority level is used by one or more tickets and cannot be deleted. Deactivate it instead.",
              "business_logic": {
                "method": "check_priority_in_use",
                "description": "Prevent deleting a priority referenced by tickets",
                "spec": "On delete action only (_action indicates delete/edit context is not applicable \u2014 this rule runs specifically for the delete operation): check whether SUPPORT360_TICKET has any row with PRIORITY_CODE equal to this record's PRIORITY_CODE. If it does, return an error instructing the user that the priority cannot be deleted and should be deactivated instead. If no ticket references it, allow the delete to proceed (return no error)."
              }
            }
          ],
          "joins": {
            "join_predicates": {
              "joins": [
                {
                  "table": "SUPPORT360_PRIORITY_MASTER",
                  "main_table": true,
                  "table_descr": "Priority master (main table)"
                }
              ]
            }
