          "validations": [
            {
              "type": "expression",
              "name": "Field change details",
              "error_code": "ACTLOG_FLD",
              "message": "A Status-Changed, Edited, Assigned or Reassigned entry must record FIELD_CHANGED and NEW_VALUE.",
              "expression": "not in_list({form.ACTION_TYPE}, \"Status-Changed,Edited,Assigned,Reassigned\") or (not_empty({form.FIELD_CHANGED}) and not_empty({form.NEW_VALUE}))"
            },
            {
              "type": "expression",
              "name": "Change date not future",
              "error_code": "ACTLOG_DT",
              "message": "Change date cannot be in the future.",
              "expression": "is_empty({form.CHANGE_DATE}) or {form.CHANGE_DATE} <= today()"
            }
          ],
