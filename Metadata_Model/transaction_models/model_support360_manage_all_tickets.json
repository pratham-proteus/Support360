          "validations": [
            {
              "type": "expression",
              "name": "Resolution notes required to Resolve",
              "error_code": "RES_NOTES_REQ",
              "message": "Resolution Notes must be entered before this ticket can be moved to Resolved.",
              "expression": "{form.status} != \"Resolved\" or not_empty({form.resolution_notes})"
            },
            {
              "type": "expression",
              "name": "Fields locked when Closed",
              "error_code": "CLOSED_LOCKED",
              "message": "Title, Description, Category and Priority cannot be changed once the ticket is Closed.",
              "expression": "{form.status} != \"Closed\""
            }
          ],
          "actions": [
            {
              "name": "Assign",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "assign_ticket",
                "description": "Assign an unassigned ticket to the current admin-selected agent",
                "spec": "Given the ticket payload (TICKET_NO, STATUS, ASSIGNED_AGENT), require STATUS = 'Open' and ASSIGNED_AGENT non-empty (the agent the Admin selected in the Assigned Agent field). Look up the ticket's current STATUS and ASSIGNED_AGENT from SUPPORT360_TICKET by TICKET_NO. Update SUPPORT360_TICKET setting STATUS = 'Assigned', CHG_DATE = now(), CHG_USER = current user (ASSIGNED_AGENT is already the submitted value, no separate write needed). Append an entry to ACTIVITY_HISTORY / SUPPORT360_TICKET_ACTLOG recording action_type 'Assigned', field_changed 'ASSIGNED_AGENT', old_value (blank, since it was unassigned), new_value (the agent), changed_by (current user) and the timestamp. Return {\"message\": \"Ticket assigned successfully\"} on success or {\"error\": \"...\"} if STATUS is not Open or no agent was supplied."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be Open to assign",
                  "message": "Only tickets with status Open can be assigned (current status {form.status}).",
                  "expression": "{form.status} == \"Open\""
                }
              ]
            },
            {
              "name": "Reassign",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "reassign_ticket",
                "description": "Reassign a ticket to a different agent, keeping the current status",
                "spec": "Given the ticket payload (TICKET_NO, STATUS, ASSIGNED_AGENT, REASSIGN_TO_AGENT), require STATUS in ('Open','Assigned','In Progress') and REASSIGN_TO_AGENT non-empty. Update SUPPORT360_TICKET setting ASSIGNED_AGENT = REASSIGN_TO_AGENT (STATUS unchanged), CHG_DATE = now(), CHG_USER = current user. Append an entry to ACTIVITY_HISTORY recording action_type 'Reassigned', field_changed 'ASSIGNED_AGENT', old_value (previous ASSIGNED_AGENT), new_value (REASSIGN_TO_AGENT), changed_by (current user) and the timestamp. Return {\"message\": \"Ticket reassigned successfully\"} on success or {\"error\": \"...\"} if the status does not allow reassignment or no target agent was supplied."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Cannot reassign a closed/resolved ticket",
                  "message": "A Resolved or Closed ticket cannot be reassigned (current status {form.status}).",
                  "expression": "{form.status} == \"Open\" or {form.status} == \"Assigned\" or {form.status} == \"In Progress\""
                }
              ]
            }
          ]
        }
      }
    ],
    "actions": [],
    "cross_updates": [],
    "pre_commit": [
      {
        "mode": "business_logic",
        "business_logic": {
          "method": "log_ticket_admin_change",
          "description": "Write an Activity/History Log entry for every Admin change to a ticket",
          "spec": "For the header form (SUPPORT360_TICKET), on both add and edit: build a log entry line with the current timestamp, the changed-by user (current logged in user), the action_type ('Created' on add, else 'Edited' or 'Status-Changed' when STATUS differs from the previous stored value, or 'Assigned'/'Reassigned' when ASSIGNED_AGENT differs, or 'Commented' when NEW_COMMENT is non-empty, or 'Attachment-Added' when ATTACHMENT differs, or 'Closed' when STATUS becomes 'Closed'), and for each changed field the field name, old value and new value. Append the formatted entry (or entries, one per changed field) to the ACTIVITY_HISTORY text column of the header row before commit. When NEW_COMMENT is non-empty, also append a formatted 'commented-by / commented-date / text' block to AGENT_COMMENTS and clear NEW_COMMENT. When STATUS is being set to 'Closed', stamp CLOSED_DATE = now() and CLOSED_BY = current user if not already set. Return null on success; return {\"error\": \"...\"} only on an unrecoverable failure (never block a normal save for logging)."
        }
      }
    ],
