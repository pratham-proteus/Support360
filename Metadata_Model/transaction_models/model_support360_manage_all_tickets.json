            {
              "column": {
                "name": "status",
                "db_name": "STATUS",
                "col_type": "VARCHAR",
                "heading": "Status",
                "descr": "Ticket lifecycle status; Admin edits follow the same Open->Assigned->In Progress->Resolved->Closed sequence as Agent Ticket Desk",
                "group_name": "Basic",
                "mandatory": true,
                "default_value": "Open",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Open",
                      "display": "Open"
                    },
                    {
                      "data": "Assigned",
                      "display": "Assigned"
                    },
                    {
                      "data": "In Progress",
                      "display": "In Progress"
                    },
                    {
                      "data": "Resolved",
                      "display": "Resolved"
                    },
                    {
                      "data": "Closed",
                      "display": "Closed"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Open",
                      "color": "blue",
                      "icon": "\u25cf",
                      "label": "Open"
                    },
                    {
                      "when": "Assigned",
                      "color": "teal",
                      "icon": "\u25cf",
                      "label": "Assigned"
                    },
                    {
                      "when": "In Progress",
                      "color": "amber",
                      "icon": "\u25cf",
                      "label": "In Progress"
                    },
                    {
                      "when": "Resolved",
                      "color": "green",
                      "icon": "\u2713",
                      "label": "Resolved"
                    },
                    {
                      "when": "Closed",
                      "color": "grey",
                      "icon": "\u2713",
                      "label": "Closed"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "validations": [
                  {
                    "type": "business_logic",
                    "name": "Status transition sequence",
                    "error_code": "STATUS_SEQ",
                    "message": "Invalid status transition for ticket {form.ticket_no}.",
                    "business_logic": {
                      "method": "validate_ticket_status_transition",
                      "description": "Enforce the ticket status transition sequence",
                      "spec": "Implement this validation using ONLY the platform's transaction record binding. Read the ticket's existing/prior STATUS from the row data the platform passes into the validation function as the current/original record context (the row already loaded for this edit) \u2014 do NOT issue any raw SQL query, do NOT open a direct database cursor/connection, and do NOT reference the table name SUPPORT360_TICKET as an executable SQL statement anywhere in this function. Read the requested new STATUS from the submitted form values. On add (_action = add), STATUS must be Open. On edit (_action = edit), allow no-change (existing STATUS == new STATUS). Allow only forward, single-step moves in the sequence Open -> Assigned -> In Progress -> Resolved -> Closed (no skipping, no reverse). Reject a move to Assigned unless ASSIGNED_AGENT is non-empty in the submitted form. Reject a move to In Progress unless the existing STATUS was Assigned. Reject a move to Resolved unless RESOLUTION_NOTES is non-empty in the submitted form. Return an error message describing the invalid transition when the rule fails, otherwise return null. Never let this function raise or propagate a raw database/SQL error."
                    }
                  }
                ],
