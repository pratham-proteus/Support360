                }
              ]
            }
          },
          "actions": [
            {
              "name": "Add",
              "handler": "system",
              "system_op": "add",
              "scope": "form",
              "validations": [
                {
                  "type": "expression",
                  "name": "Add not allowed here",
                  "message": "Tickets are logged from Create Support Ticket, not from My Tickets.",
                  "expression": "1 == 2"
                }
              ]
            },
            {
              "name": "Edit",
              "handler": "system",
              "system_op": "edit",
              "scope": "row",
              "validations": [
                {
                  "type": "expression",
                  "name": "Direct edit not allowed here",
                  "message": "Ticket fields cannot be edited from My Tickets. Use Add Comment, Add Attachment, or Confirm & Close instead.",
                  "expression": "1 == 2"
                }
              ]
            },
            {
              "name": "Delete",
              "handler": "system",
              "system_op": "delete",
              "scope": "row",
              "validations": [
                {
                  "type": "expression",
                  "name": "Delete not allowed here",
                  "message": "Tickets cannot be deleted from My Tickets.",
                  "expression": "1 == 2"
                }
              ]
            },
            {
              "name": "Confirm and Close",
              "handler": "message",
              "scope": "row",
              "visible_when": "{form.status} != \"Closed\"",
              "business_logic": {
                "method": "confirm_close_ticket",
                "description": "Employee confirms resolution and closes the ticket",
                "spec": "On the current SUPPORT360_TICKET row, set STATUS to 'Closed', CLOSED_DATE to the current timestamp, and CLOSED_BY to the current logged-in user. Append one entry to the ticket's Activity/History Log (table to be confirmed once the Ticket Activity Log object is designed) with TICKET_NO = this ticket, ACTION_TYPE = 'Closed', FIELD_CHANGED = 'STATUS', OLD_VALUE = 'Resolved', NEW_VALUE = 'Closed', CHANGED_BY = current user, CHANGE_DATE = now. Return a confirmation message such as 'Ticket {TICKET_NO} closed.'"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be Resolved",
                  "message": "Ticket {form.ticket_no} can only be closed when STATUS is Resolved (current status: {form.status}).",
                  "expression": "{form.status} == \"Resolved\""
                }
              ]
            },
            {
              "name": "Reopen Comment",
              "handler": "message",
              "scope": "row",
              "visible_when": "{form.status} != \"Closed\"",
              "business_logic": {
                "method": "add_reopen_comment",
                "description": "Employee posts a comment on the ticket without changing its status",
                "spec": "On the current SUPPORT360_TICKET row, append the text in NEW_COMMENT to AGENT_COMMENTS (prefixed with the current logged-in user and the current timestamp, on a new line), then clear NEW_COMMENT. Do not change STATUS. Append one entry to the ticket's Activity/History Log (table to be confirmed once the Ticket Activity Log object is designed) with TICKET_NO = this ticket, ACTION_TYPE = 'Commented', CHANGED_BY = current user, CHANGE_DATE = now. Return a confirmation message such as 'Comment added to ticket {TICKET_NO}.' If NEW_COMMENT is blank, return an error asking the user to enter a comment first."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Comment required",
                  "message": "Enter a comment before using Reopen Comment.",
                  "expression": "not_empty({form.new_comment})"
                },
                {
                  "type": "expression",
                  "name": "Ticket is closed",
                  "error_code": "TICKET_CLOSED_READONLY",
                  "severity": "E",
                  "message": "Ticket {form.ticket_no} is Closed; attachments can no longer be added.",
                  "expression": "{form.status} != \"Closed\""
                }
              ]
            }
          ],
          "validations": []
        }
      }
    ],
    "actions": [],
    "cross_updates": [],
    "pre_commit": [],
    "post_commit": [],
    "follow_up_actions": [],
    "attach_docs": [],
    "vector_search": {
      "enabled": true,
      "columns": [
