              "joins": [
                {
                  "table": "SUPPORT360_TICKET",
                  "main_table": true,
                  "table_descr": "Support ticket (main table)"
                },
                {
                  "table": "SUPPORT360_CATEGORY_MASTER",
                  "main_table": false,
                  "table_descr": "Category master (lookup display)",
                  "column": "CATEGORY_CODE",
                  "join_table": "SUPPORT360_TICKET",
                  "join_column": "CATEGORY_CODE",
