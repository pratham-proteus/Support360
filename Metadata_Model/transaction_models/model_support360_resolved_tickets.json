              "CREATED_DATE"
            ]
          },
          "actions": [
            {
              "name": "add",
              "handler": "system",
              "system_op": "add",
              "validations": [
                {
                  "type": "expression",
                  "name": "Block add",
                  "error_code": "RO_NO_ADD",
                  "message": "This is a read-only view of Resolved tickets; new tickets cannot be added here.",
                  "expression": "1 == 2"
                }
              ]
            },
            {
              "name": "edit",
              "handler": "system",
              "system_op": "edit",
              "validations": [
                {
                  "type": "expression",
                  "name": "Block edit",
                  "error_code": "RO_NO_EDIT",
                  "message": "Ticket {form.ticket_no} can only be edited while its status is Resolved; it is currently {form.status}. Use Close Ticket or Reopen Ticket to change status.",
                  "expression": "{form.status} == \"Resolved\""
                }
              ]
            },
            {
              "name": "delete",
              "handler": "system",
              "system_op": "delete",
              "validations": [
                {
                  "type": "expression",
                  "name": "Block delete",
                  "error_code": "RO_NO_DELETE",
                  "message": "Resolved tickets cannot be deleted from this view.",
                  "expression": "1 == 2"
                }
              ]
            },
            {
              "name": "Close Ticket",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "close_resolved_ticket",
                "description": "Close a Resolved ticket",
                "spec": "Given the current ticket's TICKET_NO, UPDATE SUPPORT360_TICKET SET STATUS = 'Closed', CLOSED_DATE = current timestamp, CLOSED_BY = the id of the currently logged-in user WHERE TICKET_NO = the current ticket's TICKET_NO AND STATUS = 'Resolved'. If no row was updated (status is no longer Resolved), return an error. Insert an entry into SUPPORT360_TICKET_ACTLOG with a new ID, TICKET_NO = the ticket's TICKET_NO, ACTION_TYPE = 'Closed', FIELD_CHANGED = 'STATUS', OLD_VALUE = 'Resolved', NEW_VALUE = 'Closed', CHANGED_BY = the current user id, CHANGE_DATE = current timestamp. Return a confirmation message such as 'Ticket <TICKET_NO> closed successfully.'",
                "language": "python"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be Resolved to close",
                  "error_code": "CLOSE_NOT_RESOLVED",
                  "message": "Ticket {form.ticket_no} cannot be closed because its status is {form.status}, not Resolved.",
                  "expression": "{form.status} == \"Resolved\""
                }
              ]
            },
            {
              "name": "Reopen Ticket",
              "handler": "message",
              "scope": "row",
              "business_logic": {
                "method": "reopen_resolved_ticket",
                "description": "Reopen a Resolved ticket back to In Progress",
                "spec": "Given the current ticket's TICKET_NO, UPDATE SUPPORT360_TICKET SET STATUS = 'In Progress' WHERE TICKET_NO = the current ticket's TICKET_NO AND STATUS = 'Resolved'. If no row was updated (status is no longer Resolved), return an error. Insert an entry into SUPPORT360_TICKET_ACTLOG with a new ID, TICKET_NO = the ticket's TICKET_NO, ACTION_TYPE = 'Status-Changed', FIELD_CHANGED = 'STATUS', OLD_VALUE = 'Resolved', NEW_VALUE = 'In Progress', CHANGED_BY = the current user id, CHANGE_DATE = current timestamp. Return a confirmation message such as 'Ticket <TICKET_NO> reopened and sent back to In Progress.'",
                "language": "python"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be Resolved to reopen",
                  "error_code": "REOPEN_NOT_RESOLVED",
                  "message": "Ticket {form.ticket_no} cannot be reopened because its status is {form.status}, not Resolved.",
                  "expression": "{form.status} == \"Resolved\""
                }
              ]
            }
          ],
          "validations": []
        }
      }
