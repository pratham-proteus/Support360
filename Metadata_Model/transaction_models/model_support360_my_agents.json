                  "table_descr": "Support agent master"
                }
              ]
            }
          },
          "validations": [
            {
              "type": "expression",
              "name": "Agent name required",
              "error_code": "AGENT_NAME_REQ",
              "message": "Agent Name is mandatory.",
              "expression": "not_empty({form.AGENT_NAME})"
            }
          ],
          "actions": [
            {
              "name": "Deactivate Agent",
              "handler": "item_change",
              "scope": "row",
              "visible_when": "{form.AGENT_STATUS} == \"Active\"",
              "business_logic": {
                "method": "deactivate_agent",
                "description": "Mark the agent Inactive",
                "spec": "Set AGENT_STATUS to 'Inactive' and AGENT_AVAILABILITY to 'Occupied' for the agent in the payload; persist the change on SUPPORT360_AGENT and return {\"updates\": {\"AGENT_STATUS\": \"Inactive\", \"AGENT_AVAILABILITY\": {\"value\": \"Occupied\", \"protect\": \"1\"}}}. Refuse with {\"error\": ...} if the agent is already Inactive."
              },
              "confirmation": {
                "mode": "reconfirm",
                "message": "Deactivate agent {form.AGENT_NAME}?"
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be active",
                  "error_code": "AGENT_ALREADY_INACTIVE",
                  "message": "Agent {form.AGENT_ID} is already Inactive.",
                  "expression": "{form.AGENT_STATUS} == \"Active\""
                }
              ]
            },
            {
              "name": "Activate Agent",
              "handler": "item_change",
              "scope": "row",
              "visible_when": "{form.AGENT_STATUS} == \"Inactive\"",
              "business_logic": {
                "method": "activate_agent",
                "description": "Mark the agent Active",
                "spec": "Set AGENT_STATUS to 'Active' and AGENT_AVAILABILITY to 'Available' for the agent in the payload; persist the change on SUPPORT360_AGENT and return {\"updates\": {\"AGENT_STATUS\": \"Active\", \"AGENT_AVAILABILITY\": {\"value\": \"Available\", \"protect\": \"0\"}}}. Refuse with {\"error\": ...} if the agent is already Active."
              },
              "validations": [
                {
                  "type": "expression",
                  "name": "Must be inactive",
                  "error_code": "AGENT_ALREADY_ACTIVE",
                  "message": "Agent {form.AGENT_ID} is already Active.",
                  "expression": "{form.AGENT_STATUS} == \"Inactive\""
                }
              ]
            }
          ]
        }
