                "heading": "Agent ID",
                "descr": "Unique identifier for the support agent",
                "key": true,
                "mandatory": true,
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Agent id unique",
                    "error_code": "AGENT_DUP",
                    "message": "Agent ID {form.AGENT_ID} already exists.",
                    "builtin": {
                      "kind": "must_be_unique",
                      "table": "SUPPORT360_AGENT",
                      "match_column": "AGENT_ID"
                    }
                  }
                ],
                "x": "10",
