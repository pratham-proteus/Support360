            {
              "column": {
                "name": "AGENT_AVAILABILITY",
                "db_name": "AGENT_AVAILABILITY",
                "table_name": "SUPPORT360_AGENT",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Availability",
                "descr": "Whether the agent is currently free to take tickets",
                "mandatory": true,
                "default_value": "Available",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Available",
                      "display": "Available"
                    },
                    {
                      "data": "Occupied",
                      "display": "Occupied"
                    }
                  ]
                },
                "validations": [
                  {
                    "type": "expression",
                    "name": "Availability valid",
                    "error_code": "AGENT_AVAIL_INVALID",
                    "message": "Availability must be Available or Occupied.",
                    "expression": "in_list({form.AGENT_AVAILABILITY}, \"Available,Occupied\")"
                  }
                ],
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Available",
                      "color": "green",
                      "icon": "\u25cf",
                      "label": "Available"
                    },
                    {
                      "when": "Occupied",
                      "color": "amber",
                      "icon": "\u25f7",
                      "label": "Occupied"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "x": "30",
                "y": "30",
                "col_id": "3",
                "table_display_name": "Support agent master",
                "db_size": "20",
                "width": 200,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "expression": "",
                "protect": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "AGENT_STATUS",
                "db_name": "AGENT_STATUS",
                "table_name": "SUPPORT360_AGENT",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Status",
                "descr": "Active agents are eligible for ticket assignment",
                "mandatory": true,
                "default_value": "Active",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Active",
                      "display": "Active"
                    },
                    {
                      "data": "Inactive",
                      "display": "Inactive"
                    }
                  ]
                },
                "validations": [
                  {
                    "type": "expression",
                    "name": "Status valid",
                    "error_code": "AGENT_STATUS_INVALID",
                    "message": "Status must be Active or Inactive.",
                    "expression": "in_list({form.AGENT_STATUS}, \"Active,Inactive\")"
                  }
                ],
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "AGENT_AVAILABILITY",
                      "expr": "iif({form.AGENT_STATUS} == \"Inactive\", \"Occupied\", {form.AGENT_AVAILABILITY})"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "AGENT_AVAILABILITY",
                      "when": "{form.AGENT_STATUS} == \"Inactive\""
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Active",
                      "color": "green",
                      "icon": "\u2713",
                      "label": "Active"
                    },
                    {
                      "when": "Inactive",
                      "color": "red",
                      "icon": "\u2715",
                      "label": "Inactive"
                    }
                  ],
                  "defaultColor": "grey"
                },
