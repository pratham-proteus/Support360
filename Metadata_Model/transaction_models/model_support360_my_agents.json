                "db_name": "AGENT_AVAILABILITY",
                "table_name": "SUPPORT360_AGENT",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Availability",
                "descr": "Current availability of the agent",
                "mandatory": true,
                "default_value": "Available",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Available",
                      "display": "Available"
                    },
                    {
                      "data": "Occupied",
                      "display": "Occupied"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Available",
                      "color": "green",
                      "icon": "\u25cf",
                      "label": "Available"
                    },
                    {
                      "when": "Occupied",
                      "color": "amber",
                      "icon": "\u25f7",
                      "label": "Occupied"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "validations": [
                  {
                    "type": "expression",
                    "name": "Availability allowed",
                    "error_code": "AGENT_AVAIL",
                    "message": "Availability must be Available or Occupied.",
                    "expression": "in_list({form.AGENT_AVAILABILITY}, \"Available,Occupied\")"
                  }
                ],
                "x": "30",
                "y": "30",
                "col_id": "3",
                "table_display_name": "Support agent master",
