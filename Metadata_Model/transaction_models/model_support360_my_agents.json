                "db_name": "AGENT_STATUS",
                "table_name": "SUPPORT360_AGENT",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Status",
                "descr": "Active agents can be assigned tickets; Inactive agents cannot",
                "mandatory": true,
                "default_value": "Active",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "Active",
                      "display": "Active"
                    },
                    {
                      "data": "Inactive",
                      "display": "Inactive"
                    }
                  ]
                },
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Active",
                      "color": "green",
                      "icon": "\u2713",
                      "label": "Active"
                    },
                    {
                      "when": "Inactive",
                      "color": "red",
                      "icon": "\u2715",
                      "label": "Inactive"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "AGENT_AVAILABILITY",
                      "expr": "iif({form.AGENT_STATUS} == \"Inactive\", \"Occupied\", {form.AGENT_AVAILABILITY})"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "AGENT_AVAILABILITY",
                      "when": "{form.AGENT_STATUS} == \"Inactive\""
                    }
                  ]
                },
                "validations": [
                  {
                    "type": "expression",
                    "name": "Status allowed",
                    "error_code": "AGENT_STATUS",
                    "message": "Status must be Active or Inactive.",
                    "expression": "in_list({form.AGENT_STATUS}, \"Active,Inactive\")"
                  }
