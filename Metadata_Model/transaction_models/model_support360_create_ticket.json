    "vector_search": {
      "enabled": true,
      "columns": [
        "title",
        "category_code",
        "status",
        "priority_code"
      ],
      "key_column": "ticket_no",
      "display_column": "title",
      "allow_alias": true,
      "auto": true,
      "reason": "looked up by support360_ticket_activity_log; searched by title plus category_code, status, priority_code so same-named records stay distinguishable"
    }
