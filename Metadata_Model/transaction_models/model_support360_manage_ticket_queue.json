                "descr": "Current ticket status; changed only via Assign / Start Progress / Resolve actions",
                "protect": "",
                "display": {
                  "type": "status_tag",
                  "map": [
                    {
                      "when": "Pending",
                      "color": "yellow",
                      "icon": "\u25cf",
                      "label": "Pending"
                    },
                    {
                      "when": "Assigned",
                      "color": "amber",
                      "icon": "\u25cf",
                      "label": "Assigned"
                    },
                    {
                      "when": "In Progress",
                      "color": "orange",
                      "icon": "\u25f7",
                      "label": "In Progress"
                    },
                    {
                      "when": "Resolved",
                      "color": "teal",
                      "icon": "\u2713",
                      "label": "Resolved"
                    },
                    {
                      "when": "Closed",
                      "color": "red",
                      "icon": "\u2715",
                      "label": "Closed"
                    }
                  ],
                  "defaultColor": "grey"
                },
                "item_change": {
                  "mode": "rule",
                  "fill": [
                    {
                      "form_col": "status",
                      "expr": "{form.status}"
                    }
                  ],
                  "protect": [
                    {
                      "form_col": "attachment",
                      "when": "{form.status} == \"Closed\""
                    },
                    {
                      "form_col": "new_comment",
                      "when": "{form.status} == \"Closed\""
                    },
                    {
                      "form_col": "resolution_notes",
                      "when": "{form.status} == \"Closed\""
                    },
