                },
                "item_change": {
                  "mode": "business_logic",
                  "business_logic": {
                    "method": "stamp_ticket_attachment",
                    "description": "Stamp attachment uploaded-by/date and log it",
                    "spec": "On change of ATTACHMENT (a new file is uploaded to this ticket by the Support Agent), set ATTACHMENT_UPLOADED_BY to the current logged-in user and ATTACHMENT_UPLOADED_DATE to the current timestamp on this SUPPORT360_TICKET row (return {\"updates\": {\"attachment_uploaded_by\": ..., \"attachment_uploaded_date\": ...}}). This must work regardless of the ticket's current STATUS. Also append one entry to the ticket's Activity/History Log (table to be confirmed once the Ticket Activity Log object is designed) with TICKET_NO = this ticket, ACTION_TYPE = 'Attachment-Added', CHANGED_BY = current user, CHANGE_DATE = now; this log write must never block the attachment update. NOTE: this method name and contract must match the identical item_change wired on the ATTACHMENT column of support360_my_tickets \u2014 implement it once and reuse."
                  }
                },
