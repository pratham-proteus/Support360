  "SOURCE_SQL": "SELECT TICKET_NO AS TICKET_NO, ACTION_TYPE AS ACTION_TYPE, FIELD_CHANGED AS FIELD_CHANGED, OLD_VALUE AS OLD_VALUE, NEW_VALUE AS NEW_VALUE, CHANGED_BY AS CHANGED_BY, CHANGE_DATE AS CHANGE_DATE FROM SUPPORT360_TICKET_ACTLOG WHERE TICKET_NO LIKE ?.ticket_no AND CHANGED_BY LIKE ?.changed_by AND ACTION_TYPE LIKE ?.action_type AND CHANGE_DATE >= ?.from_date AND CHANGE_DATE <= ?.to_date ORDER BY CHANGE_DATE DESC"
}
