      "sequence": 2,
      "mandatory": true,
      "primary_key": false,
      "nullable": false
    },
    {
      "column_name": "DESCRIPTION",
      "data_type": "TEXT",
      "size": "",
      "key": false,
      "description": "Full description of the issue or request",
      "sequence": 3,
      "mandatory": true,
      "primary_key": false,
      "nullable": false
    },
    {
      "column_name": "CATEGORY_CODE",
      "data_type": "VARCHAR",
