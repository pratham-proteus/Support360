  "phases": [
    {
      "id": "phase_1",
      "title": "Master & lookup data",
      "rationale": "Categories, priorities and the agent roster are referenced by every ticket transaction, so they come first.",
      "objects": [
        "support360_category_master",
        "support360_priority_master",
        "support360_my_agents"
      ]
    },
    {
      "id": "phase_2",
      "title": "Core ticket creation",
      "rationale": "Ticket creation depends only on the masters and produces the ticket records that every later object works on.",
      "objects": [
        "support360_create_ticket"
      ]
    },
    {
      "id": "phase_3",
      "title": "Ticket processing & views",
      "rationale": "Queue handling, assignment, resolution views and admin oversight all work on tickets that already exist and on the agent master.",
      "objects": [
        "support360_manage_ticket_queue",
        "support360_ticket_assignment",
        "support360_resolved_tickets",
        "support360_manage_all_tickets"
      ]
    },
    {
      "id": "phase_4",
      "title": "Visuals",
      "rationale": "The employee ticket charts need populated ticket data.",
      "objects": [
        "support360_my_tickets_by_priority",
        "support360_my_tickets_status_trend"
      ]
    },
    {
      "id": "phase_5",
      "title": "Dashboards",
      "rationale": "The agent and admin analytics dashboards go last because they may embed the visuals and depend on all ticket transactions.",
      "objects": [
        "support360_agent_dashboard",
        "support360_admin_dashboard"
      ]
    }
  ],
